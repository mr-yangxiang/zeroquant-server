PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/zeroquant_db
JWT_SECRET=replace-with-a-long-random-secret
ZEROQUANT_INTERNAL_TOKEN=replace-with-a-separate-internal-token

ZEROQUANT_SERVER_URL=http://127.0.0.1:3002
ZEROQUANT_REQUEST_TIMEOUT_SECONDS=5
ZEROQUANT_NEWS_CACHE_SECONDS=90
# 全球新闻每分钟检查一次；GDELT 全股票池共享请求，避免按 6 只股票重复调用。
ZEROQUANT_GLOBAL_NEWS_ENABLED=true
ZEROQUANT_GLOBAL_NEWS_CACHE_SECONDS=60
ZEROQUANT_GLOBAL_NEWS_LOOKBACK_HOURS=36
ZEROQUANT_GOOGLE_NEWS_RSS_ENABLED=true
# 可选金融新闻补充源；未配置时仍使用 GDELT + 东财公告。
ZEROQUANT_FINNHUB_API_KEY=
ZEROQUANT_ESTIMATED_ROUND_TRIP_COST_BPS=18
ZEROQUANT_MODEL_PATH=quant_engine/models/bootstrap_probability_v1.json
# 旧配置兼容项：即使设为 true，也不会放开未校准模型的交易状态。
ZEROQUANT_ALLOW_UNCALIBRATED_TRADING=false

# Optional notifications. Leave unset to disable.
ZEROQUANT_SMTP_HOST=smtp.qq.com
ZEROQUANT_SMTP_PORT=465
ZEROQUANT_SMTP_SENDER=
ZEROQUANT_SMTP_AUTH_CODE=
ZEROQUANT_EMAIL_RECIPIENTS=

# Seed creates identities only unless this is explicitly true.
ZEROQUANT_SEED_ADMIN_PHONE=
ZEROQUANT_SEED_ADMIN_PASSWORD=
ZEROQUANT_SEED_DEMO_DATA=false
