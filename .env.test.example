NODE_ENV=test
PORT=3102
DATABASE_URL=postgresql://localhost:5432/zeroquant_e2e_test
JWT_SECRET=replace-with-a-test-only-secret
ZEROQUANT_INTERNAL_TOKEN=replace-with-a-test-only-internal-token
ZEROQUANT_DISABLE_SCHEDULER=true

# E2E 客户端必须与被测服务使用同一个专用测试库和内部令牌。
ZEROQUANT_E2E_CONFIRM=true
ZEROQUANT_E2E_BASE_URL=http://127.0.0.1:3102
ZEROQUANT_E2E_INTERNAL_TOKEN=replace-with-the-same-test-only-internal-token
