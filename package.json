{
  "name": "zeroquant-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "migrate:up": "tsx src/migrations/runner.ts up",
    "migrate:down": "tsx src/migrations/runner.ts down",
    "migrate:status": "tsx src/migrations/runner.ts status",
    "schema:expected": "node --import tsx src/database/schema-verifier.ts --expected",
    "schema:catalog-check": "node --import tsx src/database/schema-catalog-check.ts",
    "schema:verify": "node --import tsx src/database/schema-verifier.ts",
    "schema:verify:json": "node --import tsx src/database/schema-verifier.ts --json",
    "test:e2e": "node --import tsx test/e2e_baseline.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
